# ===== 꼭 필요한 것 =====
# 이 앱이 인터넷에서 열리는 주소 (마지막 / 없이)
APP_URL=https://내앱주소.vercel.app

# 토큰을 암호로 잠글 때 쓰는 열쇠. 아무 글자나 32자 이상 길게!
ENCRYPTION_KEY=여기에-아주-긴-아무-문자열-32자이상-적어주세요

# 앱에 들어갈 때 물어볼 비밀번호 (비워두면 아무나 들어옴 - 꼭 정하세요)
APP_PASSWORD=내비밀번호

# ===== 유튜브 자동 업로드용 (구글) =====
# https://console.cloud.google.com → API 및 서비스 → 사용자 인증 정보 → OAuth 클라이언트 ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== 인스타 자동 등록용 (메타/페이스북) =====
# https://developers.facebook.com → 앱 만들기
META_APP_ID=
META_APP_SECRET=

# ===== 주제 자동 글쓰기용 (Claude) =====
# https://console.anthropic.com 에서 API 키 발급
ANTHROPIC_API_KEY=

# ===== 예약 발행용 =====
# 예약 실행 주소를 아무나 못 부르게 막는 암호 (아무 글자나)
CRON_SECRET=
